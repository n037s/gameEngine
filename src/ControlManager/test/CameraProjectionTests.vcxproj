<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)x64\$(Configuration)\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\ObjectManager;$(MSBuildThisFileDirectory)..\ControlManager;$(MSBuildThisFileDirectory)..\extern\SDL3-3.2.26\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)..\extern\SDL3-3.2.26\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL3.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="CameraProjectionTests.cpp" />
    <ClCompile Include="..\ObjectManager\Camera.cpp" />
    <ClCompile Include="..\ObjectManager\Geometry.cpp" />
    <ClCompile Include="..\ObjectManager\BaseRenderer.cpp" />
    <ClCompile Include="..\ControlManager\CameraControl.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopySDL" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\extern\SDL3-3.2.26\lib\x64\SDL3.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="Test" DependsOnTargets="Build;CopySDL">
    <Exec Command="&quot;$(TargetPath)&quot;" />
  </Target>
</Project>